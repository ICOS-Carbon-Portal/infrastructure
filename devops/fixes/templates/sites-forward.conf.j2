# {{ ansible_managed }}
# SITES moved to its own VM on fsicos4. Until the DNS change has reached
# everyone, these names still arrive here: in "maintenance" mode (during the
# cutover) they get a 503, in "proxy" mode they are passed on to fsicos4.
# Remove this file, and the SITES names from the ICOS certificates, once DNS
# has switched. See fixes/sites-forward-fsicos2.yml.
{% for site in sites_forward_sites %}

server {
    listen       443 ssl;
    server_name  {{ site.name }};

    ssl_certificate /etc/letsencrypt/live/{{ sites_forward_cert }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ sites_forward_cert }}/privkey.pem;

    access_log /var/log/nginx/sites-forward.access.log;

{% if sites_forward_mode == 'maintenance' %}
    location / {
        add_header Retry-After 3600 always;
        default_type text/html;
        return 503 '{{ sites_forward_maintenance_html }}';
    }
{% else %}
    # Uploads and downloads can be large; Caddy and the services set the limits.
    client_max_body_size 0;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_max_temp_file_size 0;
    proxy_read_timeout 600s;
    proxy_send_timeout 600s;

    location / {
        proxy_pass https://{{ sites_forward_target }};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        # Replace, never append: Caddy takes the first X-Forwarded-For entry
        # from a trusted proxy, so a client-sent value must not survive.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;

        proxy_ssl_server_name on;
        proxy_ssl_name $host;
        proxy_ssl_verify on;
        proxy_ssl_verify_depth 3;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
    }
{% endif %}
}
{% endfor %}

server {
    listen 80;
    server_name  {{ sites_forward_sites | map(attribute='name') | join(' ') }};

    access_log /var/log/nginx/sites-forward.access.log;

    # Let Caddy on fsicos4 answer its HTTP-01 challenges for these names,
    # in both modes, so it has certificates before we start forwarding.
    location /.well-known/acme-challenge/ {
        proxy_pass http://{{ sites_forward_target }};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}
