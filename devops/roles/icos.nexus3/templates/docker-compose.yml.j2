services:
  nexus3:
    image: sonatype/nexus3:{{ nexus3_version }}
    container_name: nexus3
    restart: unless-stopped
    ports:
      - "{{ nexus3_port }}:8081"
      - "{{ nexus3_docker_port }}:{{ nexus3_docker_port }}"
    environment:
      INSTALL4J_ADD_VM_PARAMS: "{{ nexus3_jvm_params }}"
    volumes:
      - ./data:/nexus-data
      - /etc/localtime:/etc/localtime:ro
    stop_grace_period: 2m
