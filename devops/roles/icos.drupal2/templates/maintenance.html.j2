<!DOCTYPE html>
<!-- {{ ansible_managed }} -->
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<meta http-equiv="refresh" content="60">
<title>{{ site.title | default(site.domain) }} is being updated</title>
<style>
  :root { color-scheme: light dark; --bg: #f5f6f7; --card: #fff; --text: #1d2327; --muted: #5b6770; --accent: #2a7ab0; }
  @media (prefers-color-scheme: dark) {
    :root { --bg: #15191c; --card: #1f2529; --text: #e8ecef; --muted: #a3afb8; --accent: #6fb3e0; }
  }
  html, body { height: 100%; margin: 0; }
  body { display: flex; align-items: center; justify-content: center; padding: 16px; box-sizing: border-box;
         background: var(--bg); color: var(--text); font: 17px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
  main { max-width: 32rem; background: var(--card); border-top: 4px solid var(--accent); border-radius: 6px;
         padding: 2rem 2.25rem; box-shadow: 0 1px 3px rgba(0, 0, 0, .12); }
  h1 { font-size: 1.4rem; line-height: 1.3; margin: 0 0 .75rem; }
  p { margin: 0 0 .5rem; }
  .muted { color: var(--muted); font-size: .95rem; }
</style>
</head>
<body>
<main>
  <h1>{{ site.title | default(site.domain) }} is being updated</h1>
  <p>The website is down for a few minutes while we install updates.</p>
  <p class="muted">This page reloads by itself every minute.</p>
</main>
</body>
</html>
