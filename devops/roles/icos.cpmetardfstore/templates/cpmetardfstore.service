[Unit]
Description=ICOS metadata RDF store (SPARQL endpoint and RDF4J store)
After=network.target

[Service]
Type=simple
User={{ cpmetardfstore_user }}
ExecStart={{ java_path }} {{ cpmetardfstore_java_opts }} -jar cpmetardfstore.jar
Restart=always
RestartSec=30
WorkingDirectory={{ cpmetardfstore_home }}
# The store needs time to flush and close LMDB cleanly on shutdown
TimeoutStopSec=300

[Install]
WantedBy=multi-user.target
