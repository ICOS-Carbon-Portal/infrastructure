<clickhouse>
    <profiles>
        <default>
            <log_queries>0</log_queries>
            <log_query_threads>0</log_query_threads>
            <!-- Reduce idle polling overhead; async insert flushing may be delayed. -->
            <async_insert_poll_timeout_ms>100</async_insert_poll_timeout_ms>
        </default>
    </profiles>
</clickhouse>
