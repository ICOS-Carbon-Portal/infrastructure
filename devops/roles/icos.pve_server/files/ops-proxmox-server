#!/usr/bin/env -S just --working-directory . --justfile

set positional-arguments
set shell := ['/bin/bash', '-cu']

just := "ops-proxmox-server"


@_default:
    just --list --unsorted --justfile {{justfile()}}

# make vm start on boot
onboot name:
    @qm set $(qm list | perl -anE 'say $F[0] if $F[1] eq "{{name}}"') --onboot 1

# list virtual machines and whether they autostart
onboot-list:
    @qm list | tail +2 | perl -anE \
    'printf "%-30s%sboot\n", $F[1],`qm config $F[0]`=~/onboot/ ? "" : "no "'

# create a template from the official Ubuntu cloud image, e.g. "px template-create 926 resolute"
template-create vmid codename storage="zfspool" bridge="vmbr0":
    #!/bin/bash
    set -Eeuo pipefail
    vmid={{quote(vmid)}} codename={{quote(codename)}} storage={{quote(storage)}} bridge={{quote(bridge)}}
    keyring=/etc/icos/ubuntu-cloud-image-builder.gpg
    keys=/etc/icos/vm-root-keys.pub
    for f in "$keyring" "$keys"; do
        [[ -s $f ]] || { echo "Missing $f, run the icos.pve_server role (tag pve_server_templates)"; exit 1; }
    done
    if qm status "$vmid" &>/dev/null; then echo "VMID $vmid already exists"; exit 1; fi

    # Use an explicit serial (release-YYYYMMDD) so the template records
    # exactly which image it was built from.
    base=https://cloud-images.ubuntu.com/releases/$codename
    serial=$(curl -fsSL "$base/" | grep -oE 'release-[0-9]{8}' | sort -u | tail -1)
    [[ -n $serial ]] || { echo "No releases found at $base/"; exit 1; }
    url=$base/$serial

    work=$(mktemp -d /var/tmp/template-create.XXXXXX)
    trap 'rm -rf "$work"' EXIT
    cd "$work"
    curl -fsSL -O "$url/SHA256SUMS" -O "$url/SHA256SUMS.gpg"
    gpgv --keyring "$keyring" SHA256SUMS.gpg SHA256SUMS
    img=$(grep -oE '[^ *]+-server-cloudimg-amd64\.img$' SHA256SUMS)
    [[ -n $img ]] || { echo "No amd64 server image in SHA256SUMS"; exit 1; }
    echo "Downloading $url/$img"
    curl -fSL --progress-bar -O "$url/$img"
    grep " \*$img\$" SHA256SUMS | sha256sum -c -
    version=$(echo "$img" | grep -oE '[0-9]{2}\.[0-9]{2}')

    # Everything a VM needs is a Proxmox setting; the image itself is left
    # untouched so every clone generates its own machine-id, hostname and
    # SSH host keys on first boot. No cicustom snippet and no password: root
    # logs in with the keys from $keys, which vm-create can extend per VM.
    qm create "$vmid" \
        --name "template-ubuntu-$version-${serial#release-}" \
        --description "Ubuntu $version cloud image $serial, built $(date +%F) by px template-create from $url/$img" \
        --ostype l26 --machine q35 --cpu x86-64-v2-AES --cores 2 --memory 4096 \
        --scsihw virtio-scsi-single \
        --scsi0 "$storage:0,import-from=$work/$img,discard=on,iothread=1" \
        --ide2 "$storage:cloudinit" \
        --boot order=scsi0 \
        --net0 "virtio,bridge=$bridge" \
        --serial0 socket --vga serial0 \
        --agent enabled=1 \
        --ciuser root --sshkeys "$keys" --ciupgrade 1 \
        --ipconfig0 ip=dhcp --searchdomain icos-cp.eu
    qm template "$vmid"
    echo
    qm config "$vmid" | grep -vE '^(sshkeys|smbios1|vmgenid|meta):'

# create a VM from a template, e.g. "px vm-create 926 127 drupal 60621 128G 4 16384"
vm-create template vmid name port disk="64G" cores="2" memory="8192" extra_keys="" storage="zfspool":
    #!/bin/bash
    set -Eeuo pipefail
    template={{quote(template)}} vmid={{quote(vmid)}} name={{quote(name)}} port={{quote(port)}}
    disk={{quote(disk)}} cores={{quote(cores)}} memory={{quote(memory)}} extra_keys={{quote(extra_keys)}} storage={{quote(storage)}}
    leases=/var/lib/misc/dnsmasq.vmbr0.leases
    keys=/etc/icos/vm-root-keys.pub

    die() { echo "ERROR: $*" >&2; exit 1; }

    # Checks before creating anything
    qm config "$template" 2>/dev/null | grep -q '^template: 1' || die "$template is not a template"
    qm config "$template" | grep -q '^cicustom:' && die "template $template uses cicustom, which overrides ciuser/sshkeys"
    qm status "$vmid" &>/dev/null && die "VMID $vmid already exists"
    [[ $name =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "invalid name $name"
    [[ $port =~ ^606[0-9]{2}$ ]] || die "port must be 606xx"
    for id in $(qm list | awk 'NR>1 {print $1}'); do
        conf=$(qm config "$id")
        [[ $(sed -n 's/^name: //p' <<<"$conf") == "$name" ]] && die "VM $id is already called $name"
        desc=$(sed -n 's/^description: //p' <<<"$conf" | python3 -c 'import sys,urllib.parse; print(urllib.parse.unquote(sys.stdin.read()))')
        grep -qE "port $port\b" <<<"$desc" && die "port $port is already used by VM $id"
    done
    if [[ -n $extra_keys ]]; then [[ -s $extra_keys ]] || die "$extra_keys is empty or missing"; fi

    allkeys=$(mktemp)
    trap 'rm -f "$allkeys"' EXIT
    cat "$keys" ${extra_keys:+"$extra_keys"} > "$allkeys"

    # A full clone does not depend on the template, so the template can be
    # replaced or deleted later.
    qm clone "$template" "$vmid" --name "$name" --full 1 --storage "$storage"
    qm set "$vmid" --description "port $port" --cores "$cores" --memory "$memory" \
        --onboot 1 --sshkeys "$allkeys"
    qm resize "$vmid" scsi0 "$disk"
    qm start "$vmid"

    # Checks after boot. A lease that shares its IP or DHCP client id with
    # another lease means the clone did not get its own identity: stop the
    # VM at once, before it disturbs the VM it collides with.
    mac=$(qm config "$vmid" | sed -nE 's/^net0: virtio=([0-9A-Fa-f:]+).*/\1/p' | tr A-F a-f)
    lease_of() { grep -i " $mac " "$leases" || true; }
    echo "Waiting for a DHCP lease for $mac..."
    lease=""
    for _ in $(seq 60); do
        lease=$(lease_of)
        [[ -n $lease ]] && break
        sleep 5
    done
    [[ -n $lease ]] || { qm stop "$vmid"; die "no DHCP lease after 5 minutes, VM stopped"; }
    read -r _ _ ip host cid <<<"$lease"
    others=$(grep -vi " $mac " "$leases" || true)
    if grep -q " $ip " <<<"$others" || { [[ $cid != "*" ]] && grep -qF " $cid" <<<"$others"; }; then
        qm stop "$vmid"
        die "lease '$lease' shares its IP or client id with another VM, VM stopped"
    fi
    echo "Lease OK: $ip (client id unique)"

    # The first lease can be requested before cloud-init sets the hostname.
    # icos-auto-dnat matches leases by hostname, so wait for the renewed
    # lease. Not dangerous, so only warn if it does not show up.
    echo "Waiting for the lease to carry hostname $name..."
    for _ in $(seq 60); do
        read -r _ _ _ host _ <<<"$(lease_of)"
        [[ $host == "$name" ]] && break
        sleep 5
    done
    if [[ $host != "$name" ]]; then
        echo "WARNING: lease hostname is still '$host'. SSH forwarding needs it to be $name:"
        echo "  check the VM, then run: icos-auto-dnat run"
    fi

    icos-auto-dnat run | grep -E "\b$name\b" || true
    echo
    echo "ssh -p $port root@$(hostname -f)"
