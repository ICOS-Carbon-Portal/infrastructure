<?xml version="1.0" encoding="UTF-8"?>
<!-- Managed by Ansible. No shutdown listener or management webapps. -->
<Server port="-1">
  <Listener className="org.apache.catalina.core.JreMemoryLeakPreventionListener" />
  <Service name="Catalina">
    <Connector port="{{ erddap_http_port }}" protocol="HTTP/1.1"
               connectionTimeout="300000" relaxedQueryChars="[]|"
               maxParameterCount="1000" />
    <Engine name="Catalina" defaultHost="localhost">
      <!-- nginx terminates TLS. ERDDAP uses request.getScheme() for asset URLs. -->
      <Valve className="org.apache.catalina.valves.RemoteIpValve"
             internalProxies="{{ erddap_proxy_address | regex_escape }}"
             remoteIpHeader="X-Forwarded-For"
             protocolHeader="X-Forwarded-Proto"
             protocolHeaderHttpsValue="https" />
      <Host name="localhost" appBase="webapps" unpackWARs="false" autoDeploy="false" />
    </Engine>
  </Service>
</Server>
